#!/bin/bash
# postinst - 安装/升级后处理
# 组件树（/usr/local/audiobookshelf 下的二进制/配置/服务）随 deb 分发，
# postinst 负责"派生状态"：属主、webui 解压、系统层注册（服务+nginx）、
# 首装配置引导、NNP 兼容探测、启动与健康轮询。
# 注：经 TOS 应用中心安装时平台也会注册 init.d 服务与 nginx 配置，
# 本脚本的操作全部幂等，两条安装路径行为一致。
set -e

APP_DIR=/usr/local/audiobookshelf
APP_USER=audiobookshelf
DATA_DIR=/var/lib/audiobookshelf
MAINT_LOG=/var/log/audiobookshelf-maint.log
UNIT=audiobookshelf.service
DROPIN_DIR=/etc/systemd/system/${UNIT}.d
DROPIN_COMPAT=80-audiobookshelf-exec-compat.conf

pkg_log() {
  mkdir -p /var/log 2>/dev/null || true
  echo "$(date '+%F %T') $*" >> "$MAINT_LOG" 2>/dev/null || true
}
pkg_log postinst "$1" "new=@VERSION@${2:+ old=$2}"

case "$1" in
  configure)
    # 1. 用户兜底（preinst 已建；平台自动创建路径亦覆盖）
    if ! id -u $APP_USER > /dev/null 2>&1; then
      useradd --system --user-group --no-create-home --shell /usr/sbin/nologin $APP_USER 2>/dev/null || true
    fi

    # 2. 文件属主（官方 postinst 模板：应用目录归运行用户）
    chown -R $APP_USER:$APP_USER "$APP_DIR" 2>/dev/null || true

    # 3. 解压 webui.bz2（官方模板行为；External 模式下为占位页+隐私政策）
    if [ -f "$APP_DIR/webui.bz2" ]; then
      ( cd "$APP_DIR" && tar -xjf webui.bz2 2>/dev/null || true )
    fi

    # 4. 配置文件首装引导：仅在不存在时从随包模板复制（升级永不覆盖用户配置，
    #    conffile 交互提示会卡死商店安装——坑 2）
    if [ ! -e "$APP_DIR/audiobookshelf.env" ] && [ -e "$APP_DIR/audiobookshelf.env.example" ]; then
      install -m 0640 -o $APP_USER -g $APP_USER \
        "$APP_DIR/audiobookshelf.env.example" "$APP_DIR/audiobookshelf.env"
      pkg_log postinst bootstrap "audiobookshelf.env 首装"
    fi

    # 5. 数据目录（应用数据库/元数据/缓存/备份）+ 清理历史版本包首装失败时
    #    BinaryManager 在线下载的残留（旧版包未设 SKIP_BINARIES_CHECK 时
    #    会往 config 目录写 temp.zip / libnusqlite3.so.ver / ffmpeg 等）
    install -d -o $APP_USER -g $APP_USER -m 0750 \
      "$DATA_DIR" "$DATA_DIR/config" "$DATA_DIR/metadata"
    rm -f "$DATA_DIR/config/temp.zip" "$DATA_DIR/config/libnusqlite3.so.ver" \
          "$DATA_DIR/config/ffmpeg" "$DATA_DIR/config/ffprobe" 2>/dev/null || true

    # 5b. 系统 ffmpeg 探测（V6 合规：ffmpeg 走系统包，control 里已声明
    #     Depends: ffmpeg；仅个别极端裁剪的机器可能缺失，此时不在线安装
    #     ——S8 红线——只提示维护者手工补装）
    if [ ! -x /usr/bin/ffmpeg ] || [ ! -x /usr/bin/ffprobe ]; then
      echo "警告: 系统 ffmpeg/ffprobe 缺失（本包声明了 Depends: ffmpeg，" >&2
      echo "        正常安装路径会自动装齐）。请手工执行: apt-get -f install" >&2
      pkg_log postinst "系统 ffmpeg/ffprobe 缺失（已提示）"
    fi

    # 6. 官方 deb 布局残留检测（同包名升级路径，坑 10 变体：
    #    官方包数据在 /usr/share/audiobookshelf/{config,metadata}；
    #    只打印迁移提示，绝不自动搬数据）
    if [ -d /usr/share/audiobookshelf/config ] && [ ! -e "$DATA_DIR/config/absdatabase.sqlite" ]; then
      cat >&2 <<'MIGRATE'
提示: 检测到官方 audiobookshelf deb 的旧数据目录 /usr/share/audiobookshelf/
      本包数据目录为 /var/lib/audiobookshelf/，两者不互通。
      如需迁移旧数据，请参考 /usr/local/audiobookshelf/MIGRATION.md 手动操作。
MIGRATE
      pkg_log postinst "检测到官方 deb 旧布局 /usr/share/audiobookshelf（未自动迁移）"
    fi

    # 7. NNP 兼容探测（坑 23：个别 TOS 构建在 NoNewPrivileges 下拒绝一切 execve，
    #    203/EXEC 起不来；--collect 自动清残留 unit；仅失败时装最小降级 drop-in）
    if [ "${AUDIOBOOKSHELF_EXEC_COMPAT:-auto}" = "force" ]; then
      NNP_OK=0
    elif [ "${AUDIOBOOKSHELF_EXEC_COMPAT:-auto}" = "off" ]; then
      NNP_OK=1
    else
      if timeout 15 systemd-run --wait --collect -p NoNewPrivileges=true /bin/true >/dev/null 2>&1; then
        NNP_OK=1
      else
        NNP_OK=0
      fi
    fi
    if [ "$NNP_OK" = "1" ]; then
      # 探测通过：清掉历史降级文件（可回滚），并归档未知现场 drop-in（不动）
      if [ -f "$DROPIN_DIR/$DROPIN_COMPAT" ]; then
        rm -f "$DROPIN_DIR/$DROPIN_COMPAT"
        pkg_log postinst "NNP 探测通过，移除降级 drop-in"
      fi
      if [ -d "$DROPIN_DIR" ]; then
        for f in "$DROPIN_DIR"/*.conf; do
          [ -e "$f" ] || continue
          case "$(basename "$f")" in
            "$DROPIN_COMPAT") ;;  # 已处理
            *) echo "提示: 存在自定义 drop-in $(basename "$f")，本包不改动它" >&2 ;;
          esac
        done
      fi
    else
      install -d "$DROPIN_DIR"
      cat > "$DROPIN_DIR/$DROPIN_COMPAT" <<'EOF'
# 自动生成：本机 systemd 在 NoNewPrivileges 下拒绝 execve（坑 23 兼容降级）
# 仅放宽 NNP/RSSG；服务用户、能力边界外配置一律不变
[Service]
NoNewPrivileges=false
RestrictSUIDSGID=false
EOF
      pkg_log postinst "NNP 探测失败，安装降级 drop-in $DROPIN_COMPAT"
    fi

    # 8. 系统层注册（幂等；应用中心安装时平台也会做同样的事）
    install -m 0644 "$APP_DIR/init.d/$UNIT" /etc/systemd/system/$UNIT
    systemctl daemon-reload

    # 启用（幂等，升级路径 prerm 只停不拆故必须重 enable）并（重）启动
    systemctl enable $UNIT > /dev/null 2>&1 || true
    if [ -n "${2:-}" ]; then
      systemctl restart $UNIT 2>/dev/null || true
    else
      systemctl start $UNIT 2>/dev/null || true
    fi

    # 9. nginx 路由（TOS 平台会加载 nginx/<appid>.conf，此处在系统 nginx 兜底注册）
    # 注意：裸 location 仅在 server 上下文合法（TOS 的 conf.d 即 include 在 server 层；
    # 原生 Ubuntu 的 conf.d 在 http 层会 nginx -t 失败——坑 5）；
    # 写入后立即 nginx -t 校验，失败则回滚，绝不留下导致 nginx 无法 reload 的配置
    if command -v nginx > /dev/null 2>&1 && [ -d /etc/nginx/conf.d ]; then
      install -m 0644 "$APP_DIR/nginx/audiobookshelf.conf" \
        /etc/nginx/conf.d/audiobookshelf.conf
      if nginx -t > /dev/null 2>&1; then
        nginx -s reload > /dev/null 2>&1 || true
      else
        rm -f /etc/nginx/conf.d/audiobookshelf.conf
        echo "提示: 本机 nginx 的 conf.d 不在 server 上下文，已跳过自动注册 /audiobookshelf/。" >&2
        echo "      请把 $APP_DIR/nginx/audiobookshelf.conf 的 location 段手工加入对应 server 块。" >&2
      fi
    fi

    # 10. 就绪轮询（坑 26：restart 成功 ≠ 就绪；首轮启动要初始化 SQLite 数据库，
    #     10-30s 常见；30s 上限，超时打有限快照入 dpkg 日志，不无限等待）
    WAITED=0
    until curl -fsS -o /dev/null --max-time 3 http://127.0.0.1:13378/audiobookshelf/ 2>/dev/null; do
      WAITED=$((WAITED + 2))
      if [ "$WAITED" -ge 30 ]; then
        echo "提示: 服务 30s 内未就绪（首轮初始化或数据量大时属正常）：" >&2
        systemctl --no-pager -l -n 15 status $UNIT >&2 || true
        pkg_log postinst "就绪轮询 30s 超时（已打印快照）"
        break
      fi
      sleep 2
    done
    [ "$WAITED" -ge 30 ] || pkg_log postinst "服务就绪（${WAITED}s 内 HTTP 200）"

    # 健康告警（只在 failed 时；未就绪 ≠ failed）
    if systemctl is-failed --quiet $UNIT; then
      echo "警告: audiobookshelf 启动失败，排查: journalctl -u audiobookshelf -n 50 --no-pager" >&2
    fi

    pkg_log postinst done "@VERSION@"
    echo ""
    if [ -n "${2:-}" ]; then
      echo "Audiobookshelf @VERSION@ 已完成升级（自 $2）。"
    else
      echo "Audiobookshelf @VERSION@ 已安装。"
    fi
    echo "  打开界面 : TOS 桌面 → Audiobookshelf Server 图标（新标签页打开 http://<NAS的IP>:8181/audiobookshelf/）"
    echo "  首次使用 : 打开网页 → 创建管理员账号 → 添加媒体库"
    echo "  媒体库   : 在 TOS 控制面板 → 共享文件夹，把媒体目录的访问权授予"
    echo "             应用用户 audiobookshelf（读+写），然后在网页里添加该路径"
    echo "  端口说明 : 仅监听 127.0.0.1:13378，不对外暴露端口（经 TOS nginx 路由访问）"
    echo "  媒体处理 : 使用 TOS 系统 ffmpeg 包（Ubuntu 22.04 universe，Depends 已声明）"
    echo "  数据目录 : /var/lib/audiobookshelf（apt remove 保留，purge 删除）"
    echo ""
    ;;
esac

exit 0
