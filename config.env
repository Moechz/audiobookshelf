# ============================================================
# Audiobookshelf TOS 7 应用中心 deb 打包配置
# 修改后重新运行 ./build.sh 即可
# ============================================================

# 上游版本（与官方 PPA deb 版本一致，不带 v 前缀）
ABS_VERSION=2.36.0

# 官方 deb 的 sha256（来自 PPA Packages 索引，pin 死防供应链漂移；
# 升级版本时同步更新此值）
UPSTREAM_DEB_SHA256=b316379ee29001bf587a53be82a2f762778464ea6b4b1ba17580e1cf8d4eda1e

# ffmpeg/ffprobe 不随包分发（V6 合规）：走 TOS 系统包（Ubuntu 22.04
# universe 的 ffmpeg 4.4.x，control 里 Depends: ffmpeg 声明），
# systemd unit 用 FFMPEG_PATH/FFPROBE_PATH 指向 /usr/bin/*
# 并设 SKIP_BINARIES_CHECK=1 跳过上游的 5.1 版本白名单（否则会
# 触发在线下载，违反 S8）。libnusqlite3 为上游可选组件，不设
# NUSQLITE3_PATH 即不加载（免随包预编译 .so）

# 封装迭代号（我们自己的发布序号）
# 完整版本 = 上游版本-迭代号，例如 2.36.0-2
# 三处必须一致：config.ini / DEBIAN/control / .lang；Release tag = v<完整版本>
# ⚠️ 迭代号永不零填充（dpkg 认为 -01 == -1）
PKG_RELEASE=2

# 目标架构：
#   amd64      - Intel/AMD x86_64（绝大多数 TerraMaster NAS）
#   arm64      - 上游官方 PPA 未发布 arm64 单文件二进制，暂不支持
#                （如需 arm64 需自行从源码构建 SEA 包，见 DESIGN_DECISIONS D-006）
TARGET_ARCH=amd64

# TOS 应用 id（/usr/local/<appid>/、config.ini 的 id/system_id/package、
# lang 文件名、图标文件名、systemd 单元名、系统用户名必须全部一致；上架后不可变更）
APP_ID=audiobookshelf

# 运行用户（规范要求专用非 root 用户，preinst 创建；
# 与官方 deb 的用户同名 → 从官方包升级时用户已存在，幂等）
APP_USER=audiobookshelf

# 后端监听（仅回环；与官方 deb 默认端口一致，升级路径平滑）
# 对外访问一律走 TOS nginx: http://<NAS的IP>:8181/audiobookshelf/
APP_PORT=13378

# 署名（项目决策 2026-09-21 修订）：
#   - publisher（config.ini，打包者署名）= Moechz ——往后所有 TOS 封装同此规则
#   - lang 的 auth（开发者署名）= advplyr（上游作者，用户指定，勿动）
#   - control 的 Maintainer = Moechz；Description 尾注保留 Upstream author
MAINTAINER_NAME="Moechz"
MAINTAINER_EMAIL="moechz@users.noreply.github.com"
PUBLISHER="Moechz"

# SEA 二进制来源模式（V6/D-015）：
#   compat（默认）— 上游官方 PPA deb 提取；仅供本地/真机功能验证，
#     直接提交商店会被 V6 驳（上游官方二进制亦无豁免，坑 32 实锤）
#   source（商店提交必须）— 本仓库 GitHub Actions 自建产物：
#     先跑 .github/workflows/build-sea.yml（填 ABS_VERSION），
#     把 Release build-v<版本> 里 audiobookshelf-sea-x86_64 的 sha256
#     回填 SEA_SOURCE_SHA256，并按实际仓库改 SEA_SOURCE_URL
BUILD_MODE=source
SEA_SOURCE_URL=https://github.com/Moechz/audiobookshelf/releases/download/build-v2.36.0/audiobookshelf-sea-x86_64
SEA_SOURCE_SHA256=30b6b30274436204cddac84b2d5bc36a49b59d2974b1a5b6ccbff34992f7fb72
